          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT bucket AS time, buy_volume / NULLIF(sell_volume, 0) AS ratio FROM candles_1m WHERE product_id = '$product' AND $__timeFilter(bucket) ORDER BY bucket"
