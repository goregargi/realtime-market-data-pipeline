    {
      "id": 6,
      "title": "Volume spikes (z > 3)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT bucket AS \"time\", product_id, ROUND(volume::numeric, 4) AS volume, ROUND(avg_volume_30m::numeric, 4) AS avg_30m, z_score FROM volume_spikes WHERE $__timeFilter(bucket) ORDER BY bucket DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Candles whose volume is more than 3 standard deviations above the previous 30 minutes."
    },
