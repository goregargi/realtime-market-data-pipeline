      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT layer, reason, COUNT(*) AS events, MAX(recorded_at) AS last_seen FROM dead_letter_events WHERE $__timeFilter(recorded_at) GROUP BY layer, reason ORDER BY events DESC"
